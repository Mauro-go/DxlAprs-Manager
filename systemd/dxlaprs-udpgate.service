[Unit]
Description=DxlAprs Manager - udpgate4
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dxlaprs
ExecStart=/usr/bin/python3 /opt/dxlaprs-manager/run_udpgate.py
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
