[Unit]
Description=DxlAprs Manager Native Monitor Collector
After=dxlaprs-udpgate.service
Requires=dxlaprs-udpgate.service

[Service]
Type=simple

WorkingDirectory=/opt/dxlaprs-manager

ExecStart=/usr/bin/python3 /opt/dxlaprs-manager/native_collector.py

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
